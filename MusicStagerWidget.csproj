<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>idwr-Music-Stager-v0.1-b9</AssemblyName>
    <RootNamespace>MusicStagerWidget</RootNamespace>
    <AssemblyTitle>(idwr) Music Stager</AssemblyTitle>
    <Product>(idwr) Music Stager</Product>
    <Version>0.1.0-b9</Version>
    <FileVersion>0.1.0.9</FileVersion>
    <Authors>indewer</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\words_freq.txt.gz" />
    <None Update="Resources\words_freq.txt.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
